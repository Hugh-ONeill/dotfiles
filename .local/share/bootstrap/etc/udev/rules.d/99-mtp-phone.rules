# Auto-mount/unmount Samsung Galaxy (MTP) for user wiz via jmtpfs systemd user service.
# The phone only enumerates with this ID *after* it is unlocked and set to
# "File Transfer" mode on the device, so this rule fires at exactly that moment.

# Plugged in (and in MTP mode) -> (re)start the user mount service.
# restart, not start: a service left "active" with a dead mount would make start a no-op,
# and the phone re-enumerates (remove + add) when "Allow access to phone data" is tapped.
# The service itself waits for the grant before mounting (phone-wait-grant).
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="04e8", ATTR{idProduct}=="6860", \
  RUN+="/bin/su wiz -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/systemctl --user --no-block restart phone-mount.service'"

# Unplugged -> stop the service (which unmounts ~/phone). Sysfs attributes are gone once the
# device is removed, so match the kernel's PRODUCT property (vendor/product/bcdDevice, hex
# without leading zeros), which is part of the remove event itself.
ACTION=="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="4e8/6860/*", \
  RUN+="/bin/su wiz -c 'XDG_RUNTIME_DIR=/run/user/1000 /usr/bin/systemctl --user --no-block stop phone-mount.service'"
