#!/usr/bin/env python3
# Terminal sudo password prompt that echoes a gradient of theme symbols instead of nothing
# Usage: sudo-askpass-tty "<prompt>"   (run by ~/.local/bin/sudo-askpass when /dev/tty is available;
#        prints the password on stdout, exit 1 on cancel, exit 2 if there is no terminal)

import os
import sys
import termios
from pathlib import Path

# ============================================================
# SETTINGS
# ============================================================

MASK_CONF = Path.home() / ".config/themes/current/password-mask.conf"
DEFAULT_SYMBOLS = ["*"]
DEFAULT_GRADIENT = ["#ffffff"]
STEP = 0.5          # gradient stops advanced per typed character
RESET = "\x1b[0m"

# ============================================================
# MASK
# ============================================================


def load_mask() -> tuple[list[str], list[tuple[int, int, int]]]:
    """Symbols and gradient stops from the theme's password-mask.conf."""
    symbols, gradient = DEFAULT_SYMBOLS, DEFAULT_GRADIENT
    try:
        for line in MASK_CONF.read_text().splitlines():
            key, _, value = line.partition("=")
            if key.strip() == "symbols" and value.split():
                symbols = value.split()
            elif key.strip() == "gradient" and value.split():
                gradient = value.split()
    except OSError:
        pass
    stops = [(int(h[1:3], 16), int(h[3:5], 16), int(h[5:7], 16)) for h in gradient]
    return symbols, stops


def mask_char(index: int, symbols: list[str], stops: list[tuple[int, int, int]]) -> str:
    """The colored symbol for the character at `index`; the gradient wraps around."""
    pos = (index * STEP) % len(stops)
    lo = int(pos)
    hi = (lo + 1) % len(stops)
    t = pos - lo
    r, g, b = (round(a + (c - a) * t) for a, c in zip(stops[lo], stops[hi]))
    return f"\x1b[38;2;{r};{g};{b}m{symbols[index % len(symbols)]}{RESET}"


# ============================================================
# PROMPT
# ============================================================


def read_password(tty: int, prompt: str) -> str | None:
    """Read a line from the terminal with masked echo; None if cancelled."""
    symbols, stops = load_mask()
    old = termios.tcgetattr(tty)
    new = termios.tcgetattr(tty)
    new[3] &= ~(termios.ECHO | termios.ICANON | termios.ISIG)   # lflags: no echo, raw lines, ^C as a byte
    new[6][termios.VMIN] = 1
    new[6][termios.VTIME] = 0
    chars: list[str] = []
    pending = b""                                               # partial UTF-8 sequence

    def out(s: str) -> None:
        os.write(tty, s.encode())

    termios.tcsetattr(tty, termios.TCSAFLUSH, new)
    try:
        out(prompt)
        while True:
            byte = os.read(tty, 1)
            if not byte:
                return None
            b = byte[0]
            if b in (0x0A, 0x0D):                               # Enter
                out("\r\n")
                return "".join(chars)
            if b in (0x03, 0x04, 0x1B):                         # ^C, ^D, Esc
                out("\r\n")
                return None
            if b in (0x7F, 0x08):                               # Backspace
                if chars:
                    chars.pop()
                    out("\b \b")
                continue
            if b == 0x15:                                       # ^U: clear the line
                out("\b \b" * len(chars))
                chars.clear()
                continue
            if b < 0x20:
                continue
            pending += byte
            try:
                ch = pending.decode()
            except UnicodeDecodeError:
                if len(pending) < 4:
                    continue
                pending = b""
                continue
            pending = b""
            out(mask_char(len(chars), symbols, stops))
            chars.append(ch)
    finally:
        termios.tcsetattr(tty, termios.TCSAFLUSH, old)


def main() -> None:
    prompt = sys.argv[1] if len(sys.argv) > 1 else "Password: "
    try:
        tty = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    except OSError:
        sys.exit(2)
    try:
        password = read_password(tty, prompt)
    finally:
        os.close(tty)
    if password is None:
        sys.exit(1)
    sys.stdout.write(password + "\n")


if __name__ == "__main__":
    main()
