#!/bin/sh
# Wait until the phone exposes MTP storage, i.e. it is unlocked and "Allow access to phone data" was tapped.
# jmtpfs reads the storage list once at startup; started before the grant, it mounts a dead session.
# Run by phone-mount.service before jmtpfs (the mount must be stopped: only one MTP client at a time).
# Usage: phone-wait-grant [seconds]   (default 60; always exits 0 so jmtpfs still gets its try)

limit=${1:-60}
start=$(date +%s)
while :; do
    if timeout 12 mtp-detect 2>/dev/null | grep -q StorageID; then
        exit 0
    fi
    [ $(( $(date +%s) - start )) -ge "$limit" ] && exit 0
    sleep 3
done
