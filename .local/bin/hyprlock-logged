#!/bin/bash
# Launch hyprlock, capture stderr, and RESTART it if it dies while still locked.
#
# Root cause (confirmed 2026-08-29): when the ViewSonic drops its DP link on
# dpms-off, amdgpu fails link training and Hyprland churns wl_output globals
# (real output removed -> HEADLESS fallback added -> removed -> real output
# back). hyprlock races that and binds an already-dead global:
#     wl_registry#10: error 0: global wl_output (98) is unavailable
#     ASSERTION FAILED! [core] Disconnected from pollfd id 0
#     at: line 414 in hyprlock.cpp
# -> SIGABRT (rc 134), session left locked with no client = lockdead screen.
#
# We cannot fix the race from out here, but we can make it invisible: if
# hyprlock dies abnormally while the session is still locked, bring it right
# back. Needs misc:allow_session_lock_restore = true (set in general.conf).
#
# 2026-10-03: a hyprlock started 09-15 outlived its lock and spun on
# "got poll event" TRACE lines for 18 days, filling the disk (20 TB apparent
# in ~/.local/state/hyprlock.log). So: no --verbose (the assertion above
# prints without it), output goes to journald (size-capped; read with
# `journalctl --user -t hyprlock`), and a watchdog kills a hyprlock that is
# still running after the session has been unlocked.

set -u
MAX_RESTARTS=10          # give up rather than spin forever
MIN_HEALTHY_SECS=120     # a run this long counts as healthy; reset the counter
ORPHAN_CHECK_SECS=30     # watchdog poll; 2 unlocked polls in a row = orphan

log() { echo "===== $* =====" | systemd-cat -t hyprlock-logged; }

is_locked() { hyprctl locked 2>/dev/null | grep -q true; }

attempts=0
while :; do
    log "hyprlock starting (attempt $((attempts + 1)))"
    start=$SECONDS

    hyprlock > >(systemd-cat -t hyprlock) 2>&1 &
    pid=$!

    misses=0
    while kill -0 "$pid" 2>/dev/null; do
        sleep "$ORPHAN_CHECK_SECS"
        if is_locked; then
            misses=0
        else
            misses=$(( misses + 1 ))
            if (( misses >= 2 )) && kill -0 "$pid" 2>/dev/null; then
                log "session unlocked but hyprlock still running; killing orphan"
                kill "$pid"
                break
            fi
        fi
    done
    wait "$pid"
    rc=$?
    ran=$(( SECONDS - start ))

    log "hyprlock exited rc=$rc after ${ran}s"

    # Clean exit == user unlocked. Done.
    (( rc == 0 )) && break

    # Session no longer locked (someone unlocked another way). Done.
    if ! is_locked; then
        log "session no longer locked; not restarting"
        break
    fi

    # A long healthy run before the crash isn't a restart loop.
    (( ran >= MIN_HEALTHY_SECS )) && attempts=0

    attempts=$(( attempts + 1 ))
    if (( attempts >= MAX_RESTARTS )); then
        log "giving up after $attempts restarts -- lockdead screen will show"
        break
    fi

    log "crashed while locked; restarting in 1s"
    sleep 1
done
