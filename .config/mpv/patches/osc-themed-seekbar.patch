+-- [themed seekbar] parsed copies of the color options, rebuilt with the styles
+local seekbar_colors = { gradient = {}, segments = {}, segment = "00D400" }
+
+local function set_seekbar_colors()
+    local gradient = {}
+    for hex in user_opts.seekbar_gradient:gmatch("#(%x%x%x%x%x%x)") do
+        gradient[#gradient + 1] = {
+            tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16),
+        }
+    end
+    local segments = {}
+    for category, color in user_opts.segment_colors:gmatch("([%w_]+)=(#%x%x%x%x%x%x)") do
+        segments[category] = osc_color_convert(color)
+    end
+    seekbar_colors = {
+        gradient = gradient,
+        segments = segments,
+        segment = osc_color_convert(user_opts.segment_color),
+    }
+end
+
+-- [themed seekbar] position 0..1 along the gradient as ASS BBGGRR
+local function seekbar_gradient_at(pos)
+    local cols = seekbar_colors.gradient
+    if #cols == 0 then return osc_color_convert(user_opts.timecode_color) end
+    if #cols == 1 then
+        return string.format("%02X%02X%02X", cols[1][3], cols[1][2], cols[1][1])
+    end
+    pos = math.max(0, math.min(1, pos)) * (#cols - 1)
+    local i = math.min(math.floor(pos), #cols - 2)
+    local a, b, f = cols[i + 1], cols[i + 2], pos - i
+    local function mix(k) return math.floor(a[k] + (b[k] - a[k]) * f + 0.5) end
+    return string.format("%02X%02X%02X", mix(3), mix(2), mix(1))
+end
