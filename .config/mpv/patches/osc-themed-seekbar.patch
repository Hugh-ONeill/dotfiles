+-- [themed seekbar] draws the whole seekbar in place of the stock slider: a dim
+-- track cut into chapter pieces, the buffered range a little brighter, the
+-- played part in the gradient, SponsorBlock segments on top and a round handle.
+-- Each color is its own ASS event, positioned at the element's top-left corner.
+local function draw_themed_seekbar(master_ass, element)
+    local geo = element.layout.geometry
+    local x0, y0 = element.hitbox.x1, element.hitbox.y1
+    local left, right = element.slider.min.ele_pos, element.slider.max.ele_pos
+    local width = right - left
+    if width <= 0 then return end
+
+    local hover = mouse_hit(element) or elements[state.active_element] == element
+    local th = geo.h * (hover and 0.42 or 0.28)  -- track thickness
+    local top = (geo.h - th) / 2
+    local duration = mp.get_property_number("duration", 0)
+    local pos = element.slider.posF()
+    local xp = pos and get_slider_ele_pos_for(element, pos) or left
+    local fg = osc_color_convert(user_opts.timecode_color)
+
+    -- the track as x intervals, with a gap at every chapter start
+    local pieces, from, gap = {}, left, user_opts.seekbar_chapter_gap
+    if duration > 0 and gap > 0 then
+        for _, chapter in ipairs(state.chapter_list) do
+            local x = left + width * chapter.time / duration
+            if x - gap / 2 > from + 2 and x + gap / 2 < right - 2 then
+                pieces[#pieces + 1] = { from, x - gap / 2 }
+                from = x + gap / 2
+            end
+        end
+    end
+    pieces[#pieces + 1] = { from, right }
+
+    -- the parts of the track between two x positions, appended to `out`
+    local function span(a, b, out)
+        out = out or {}
+        for _, piece in ipairs(pieces) do
+            local s, e = math.max(piece[1], a), math.min(piece[2], b)
+            if e > s then out[#out + 1] = { s, e } end
+        end
+        return out
+    end
+
+    local function event(color, alpha)
+        master_ass:new_event()
+        master_ass:pos(x0, y0)
+        master_ass:an(7)
+        master_ass:append("{\\blur0\\bord0\\shad0\\1c&H" .. color .. "&}")
+        ass_append_alpha(master_ass, { [1] = alpha, [2] = 255, [3] = 255, [4] = 255 }, 0)
+    end
+
+    local function fill(color, alpha, spans)
+        if #spans == 0 then return end
+        event(color, alpha)
+        master_ass:draw_start()
+        for _, s in ipairs(spans) do
+            master_ass:rect_cw(s[1], top, s[2], top + th)
+        end
+        master_ass:draw_stop()
+    end
+
+    fill(fg, 200, span(left, right))
+
+    -- buffered ahead of the playhead
+    local buffered = {}
+    for _, range in pairs(element.slider.seekRangesF() or {}) do
+        local a = math.max(get_slider_ele_pos_for(element, range["start"]), xp)
+        local b = get_slider_ele_pos_for(element, range["end"])
+        if b > a then span(a, b, buffered) end
+    end
+    fill(fg, 150, buffered)
+
+    -- played part: slices of the gradient, each color fixed to its place on the bar
+    local slices = 48
+    local sw = width / slices
+    for i = 0, slices - 1 do
+        local a = left + i * sw
+        if a >= xp then break end
+        -- half a pixel of overlap hides the seams between slices
+        fill(seekbar_gradient_at((i + 0.5) / slices), 0,
+             span(a, math.min(a + sw + 0.5, xp)))
+    end
+
+    if duration > 0 then
+        for _, seg in ipairs(state.sb_segments) do
+            local a = left + width * math.max(0, math.min(1, seg.start / duration))
+            local b = left + width * math.max(0, math.min(1, seg["end"] / duration))
+            fill(seekbar_colors.segments[seg.category] or seekbar_colors.segment, 0,
+                 span(a, math.max(b, a + 2)))
+        end
+    end
+
+    if pos then
+        local r = geo.h * (hover and 0.3 or 0.2)
+        event(fg, 0)
+        master_ass:draw_start()
+        master_ass:round_rect_cw(xp - r, geo.h / 2 - r, xp + r, geo.h / 2 + r, r)
+        master_ass:draw_stop()
+    end
+end
