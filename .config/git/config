[core]
	pager = delta
	autocrlf = input

[interactive]
	diffFilter = delta --color-only

[include]
	# generated by the theme system (templates/delta.gitconfig.tmpl)
	path = ~/.config/themes/current/delta.gitconfig

[delta]
	navigate = true    # use n and N to move between diff sections
	features = theme

[merge]
	conflictstyle = diff3

[commit]
	gpgsign = true

[tag]
	gpgsign = true

# Machine-specific config (user, credentials, etc.)
[include]
	path = config.local
