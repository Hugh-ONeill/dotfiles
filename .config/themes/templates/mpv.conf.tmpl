# ${THEME_NAME} theme for mpv
# Usage: generated by the theme system; included from ~/.config/mpv/mpv.conf

# ============================================================
# PLAYER
# ============================================================

background-color='${BASE}'
osd-color='${TEXT}'
osd-outline-color='${CRUST}'
osd-back-color='${MANTLE}'
osd-selected-color='${ACCENT}'
osd-selected-outline-color='${CRUST}'

# ============================================================
# ON-SCREEN CONTROLLER
# ============================================================

script-opts-append='osc-background_color=${CRUST}'
script-opts-append='osc-title_color=${TEXT}'
script-opts-append='osc-timecode_color=${SUBTEXT1}'
script-opts-append='osc-buttons_color=${TEXT}'
script-opts-append='osc-top_buttons_color=${TEXT}'
script-opts-append='osc-small_buttonsL_color=${SUBTEXT1}'
script-opts-append='osc-small_buttonsR_color=${SUBTEXT1}'
script-opts-append='osc-held_element_color=${ACCENT}'
script-opts-append='osc-time_pos_color=${TEXT}'
script-opts-append='osc-time_pos_outline_color=${CRUST}'

# ============================================================
# CONSOLE / SELECT MENU
# ============================================================

script-opts-append='console-match_color=${ACCENT}'
script-opts-append='console-focused_color=${CRUST}'
script-opts-append='console-focused_back_color=${ACCENT}'
script-opts-append='console-menu_outline_color=${SURFACE2}'

# ============================================================
# LOADING ANIMATION
# ============================================================

# bar colors for scripts/loading.lua, cycled smoothly left to right
script-opts-append='loading-gradient=${GRADIENT_0} ${GRADIENT_1} ${GRADIENT_2} ${GRADIENT_3} ${GRADIENT_4} ${GRADIENT_5} ${GRADIENT_6} ${GRADIENT_7} ${GRADIENT_8} ${GRADIENT_9}'

# ============================================================
# STATS OVERLAY
# ============================================================

# ASS colors: BBGGRR, no leading #
script-opts-append=stats-font_color=${TEXT_BGR}
script-opts-append=stats-border_color=${CRUST_BGR}
script-opts-append=stats-plot_bg_color=${MANTLE_BGR}
script-opts-append=stats-plot_bg_border_color=${ACCENT_BGR}
script-opts-append=stats-plot_color=${ACCENT_BGR}
