:root {
  --rosewater: ${TEXT};
  --flamingo: ${GRADIENT_1};
  --pink: ${GRADIENT_9};
  --mauve: ${GRADIENT_8};
  --red: ${SEM_ERR};
  --maroon: ${GRADIENT_0};
  --peach: ${GRADIENT_1};
  --yellow: ${SEM_WARN};
  --green: ${SEM_OK};
  --teal: ${GRADIENT_4};
  --sky: ${GRADIENT_5};
  --sapphire: ${GRADIENT_6};
  --blue: ${SEM_INFO};
  --lavender: ${ACCENT};

  --main-color: var(--mauve);
  --main-background: ${BASE};
  --main-background-transparent: ${BASE}cc;
  --hover-background: ${SURFACE0};
  --hover-background-transparent: ${SURFACE0}b3;
  --second-background: ${MANTLE};
  --main-text: ${TEXT};
  --white-text: ${TEXT};
  --dimmer-text: ${OVERLAY2};

  --red-color: var(--red);
  --green-color: var(--green);
  --blue-color: var(--blue);
  --cyan-color: var(--sky);
  --yellow-color: var(--yellow);
}
