    [class*="DownloadPage_header"] img {
      @svg: escape(
        '<svg width="27" height="32" viewBox="0 0 27 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20.396 32a6.35 6.35 0 0 1-3.517-1.067A6.36 6.36 0 0 1 13.362 32a6.35 6.35 0 0 1-3.516-1.067A6.27 6.27 0 0 1 6.372 32h-.038a6.26 6.26 0 0 1-4.5-1.906 6.38 6.38 0 0 1-1.836-4.482v-12.25C0 5.995 5.994 0 13.363 0s13.362 5.994 13.362 13.363v12.253c0 3.393-2.626 6.192-5.978 6.375q-.175.01-.352.009" fill="@{accent}"/><path d="M20.396 30.593a4.93 4.93 0 0 1-3.08-1.083.66.66 0 0 0-.42-.145.8.8 0 0 0-.488.176 4.94 4.94 0 0 1-3.046 1.055 4.94 4.94 0 0 1-3.045-1.055.75.75 0 0 0-.942 0 4.9 4.9 0 0 1-3.01 1.055h-.033a4.85 4.85 0 0 1-3.49-1.482 4.98 4.98 0 0 1-1.436-3.498V13.367c0-6.597 5.364-11.96 11.957-11.96 6.592 0 11.956 5.363 11.956 11.956v12.253c0 2.645-2.042 4.827-4.65 4.97a5 5 0 0 1-.274.007" fill="@{crust}"/><path d="M23.912 13.363v12.253c0 1.876-1.447 3.463-3.32 3.566a3.5 3.5 0 0 1-2.398-.769c-.778-.626-1.873-.598-2.658.021a3.5 3.5 0 0 1-2.176.753 3.5 3.5 0 0 1-2.173-.753 2.15 2.15 0 0 0-2.684 0 3.5 3.5 0 0 1-2.15.753c-1.948.014-3.54-1.627-3.54-3.575v-12.25c0-5.825 4.724-10.549 10.55-10.549 5.825 0 10.549 4.724 10.549 10.55" fill="@{text}"/><path d="m11.28 12.437-3.93-2.27a1.07 1.07 0 0 0-1.463.392 1.07 1.07 0 0 0 .391 1.463l2.326 1.343-2.326 1.343a1.072 1.072 0 0 0 1.071 1.855l3.932-2.27a1.07 1.07 0 0 0 0-1.854zm8.902-.146h-5.164a1.071 1.071 0 1 0 0 2.143h5.164a1.071 1.071 0 1 0 0-2.143" fill="@{crust}"/></svg>'
