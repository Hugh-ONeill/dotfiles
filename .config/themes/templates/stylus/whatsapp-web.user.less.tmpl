  @frappe: { @rosewater: ${ACCENT_FILTER}; @flamingo: ${ACCENT_SECONDARY_FILTER}; @pink: ${ACCENT_FILTER}; @mauve: ${ACCENT_FILTER}; @red: ${SEM_ERR_FILTER}; @maroon: ${SEM_ERR_FILTER}; @peach: ${SEM_WARN_FILTER}; @yellow: ${SEM_WARN_FILTER}; @green: ${SEM_OK_FILTER}; @teal: ${ACCENT_TERTIARY_FILTER}; @sky: ${SEM_INFO_FILTER}; @sapphire: ${SEM_INFO_FILTER}; @blue: ${SEM_LINK_FILTER}; @lavender: ${ACCENT_BRIGHT_FILTER}; @text: ${TEXT_FILTER}; @subtext1: ${SUBTEXT1_FILTER}; @subtext0: ${SUBTEXT0_FILTER}; @overlay2: ${OVERLAY2_FILTER}; @overlay1: ${OVERLAY1_FILTER}; @overlay0: ${OVERLAY0_FILTER}; @surface2: ${SURFACE2_FILTER}; @surface1: ${SURFACE1_FILTER}; @surface0: ${SURFACE0_FILTER}; @base: ${BASE_FILTER}; @mantle: ${MANTLE_FILTER}; @crust: ${CRUST_FILTER}; };
  @macchiato: { @rosewater: ${ACCENT_FILTER}; @flamingo: ${ACCENT_SECONDARY_FILTER}; @pink: ${ACCENT_FILTER}; @mauve: ${ACCENT_FILTER}; @red: ${SEM_ERR_FILTER}; @maroon: ${SEM_ERR_FILTER}; @peach: ${SEM_WARN_FILTER}; @yellow: ${SEM_WARN_FILTER}; @green: ${SEM_OK_FILTER}; @teal: ${ACCENT_TERTIARY_FILTER}; @sky: ${SEM_INFO_FILTER}; @sapphire: ${SEM_INFO_FILTER}; @blue: ${SEM_LINK_FILTER}; @lavender: ${ACCENT_BRIGHT_FILTER}; @text: ${TEXT_FILTER}; @subtext1: ${SUBTEXT1_FILTER}; @subtext0: ${SUBTEXT0_FILTER}; @overlay2: ${OVERLAY2_FILTER}; @overlay1: ${OVERLAY1_FILTER}; @overlay0: ${OVERLAY0_FILTER}; @surface2: ${SURFACE2_FILTER}; @surface1: ${SURFACE1_FILTER}; @surface0: ${SURFACE0_FILTER}; @base: ${BASE_FILTER}; @mantle: ${MANTLE_FILTER}; @crust: ${CRUST_FILTER}; };
