/* ==UserStyle==
@name job-scan + news-scan dashboards
@namespace local/scan-dashboards
@version 2026.11.07
@description Themes the job-scan (:8765) and news-scan (:8766) dashboards from the active palette. Each machine's Stylus serves its own theme, so the laptop shows its theme over the tunnel while the desktop shows its own.
@author wiz
@license MIT
@preprocessor less
==/UserStyle== */

// Both dashboards take every color from these :root vars (color-mix tints
// included), so redefining them is the whole style. Only keys every palette
// has: semantic, ANSI, accent, and the surface ramp. Peach (score 60, the HN
// tag) is a warn/err blend because most palettes have no peach; plain CSS
// color-mix, since LESS leaves custom-property values unevaluated.

@-moz-document url-prefix("http://localhost:8765/"), url-prefix("http://127.0.0.1:8765/"),
               url-prefix("http://localhost:8766/"), url-prefix("http://127.0.0.1:8766/") {
  :root {
    color-scheme: ${THEME_MODE} !important;
    --bg: ${MANTLE} !important;
    --panel: ${BASE} !important;
    --panel-2: ${SURFACE0} !important;
    --border: ${SURFACE1} !important;
    --border-field: ${OVERLAY1} !important;
    --text: ${TEXT} !important;
    --muted: ${OVERLAY2} !important;
    --subtext: ${SUBTEXT1} !important;
    --on-accent: ${CRUST} !important;
    --accent: ${ACCENT} !important;
    --good: ${SEM_OK} !important;
    --warn: ${SEM_WARN} !important;
    --bad: ${SEM_ERR} !important;
    --star: ${SEM_WARN} !important;
    --peach: color-mix(in srgb, ${SEM_WARN}, ${SEM_ERR}) !important;
    --breakout: ${ACCENT_TERTIARY} !important;
    --score-90: ${SEM_OK} !important;
    --score-80: ${ANSI_CYAN} !important;
    --score-70: ${SEM_WARN} !important;
    --score-60: color-mix(in srgb, ${SEM_WARN}, ${SEM_ERR}) !important;
    --score-lo: ${OVERLAY0} !important;
  }
}
