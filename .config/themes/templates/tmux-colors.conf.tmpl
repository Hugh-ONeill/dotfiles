# vim:set ft=tmux:

# ${THEME_NAME} palette for catppuccin/tmux (port of themes/catppuccin_mocha_tmux.conf)
# Sourced before the plugin runs; the plugin only sets @thm_* when unset (-o).
set -gq @thm_bg "${BASE}"
set -gq @thm_fg "${TEXT}"

# Colors
set -gq @thm_rosewater "${TEXT}"
set -gq @thm_flamingo "${GRADIENT_1}"
set -gq @thm_pink "${GRADIENT_9}"
set -gq @thm_mauve "${GRADIENT_8}"
set -gq @thm_red "${SEM_ERR}"
set -gq @thm_maroon "${GRADIENT_0}"
set -gq @thm_peach "${GRADIENT_1}"
set -gq @thm_yellow "${SEM_WARN}"
set -gq @thm_green "${SEM_OK}"
set -gq @thm_teal "${GRADIENT_4}"
set -gq @thm_sky "${GRADIENT_5}"
set -gq @thm_sapphire "${GRADIENT_6}"
set -gq @thm_blue "${SEM_INFO}"
set -gq @thm_lavender "${ACCENT}"

# Surfaces and overlays
set -gq @thm_subtext_1 "${SUBTEXT0}"
set -gq @thm_subtext_0 "${SUBTEXT1}"
set -gq @thm_overlay_2 "${OVERLAY2}"
set -gq @thm_overlay_1 "${OVERLAY1}"
set -gq @thm_overlay_0 "${OVERLAY0}"
set -gq @thm_surface_2 "${SURFACE2}"
set -gq @thm_surface_1 "${SURFACE1}"
set -gq @thm_surface_0 "${SURFACE0}"
set -gq @thm_mantle "${MANTLE}"
set -gq @thm_crust "${CRUST}"

