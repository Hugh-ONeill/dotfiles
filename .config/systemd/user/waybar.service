# Full replacement for /usr/lib/systemd/user/waybar.service.
# Bound to graphical-session.target, which comes up with the compositor on
# either launch path: under uwsm, uwsm binds it to hyprland-session.target and
# exports WAYLAND_DISPLAY first; with plain start-hyprland from a TTY (the
# laptop's ~/.zprofile), Hyprland activates its own hyprland-session.target,
# which BindsTo graphical-session.target. Either way waybar starts with the
# compositor and stops with it. It must NOT be wanted by
# default.target: the user manager starts that seconds before Hyprland is up,
# waybar then dies with "cannot open display" five times in three seconds and
# trips its start limit, after which even the autostart restart is refused
# (seen 2026-11-01, first 0.57 login).
[Unit]
Description=Waybar (supervised)
Documentation=https://github.com/Alexays/Waybar/wiki/
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/waybar
ExecReload=kill -SIGUSR2 $MAINPID
# A wl_output teardown kills waybar with a Wayland protocol error; come back
# from that as well as from a clean exit.
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
