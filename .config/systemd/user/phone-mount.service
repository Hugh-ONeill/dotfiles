[Unit]
Description=Mount Android phone via jmtpfs (MTP)
Documentation=man:jmtpfs(1)

[Service]
Type=forking
# Make sure the mountpoint exists and clear any stale mount from a previous abrupt unplug
ExecStartPre=-/usr/bin/mkdir -p %h/phone
ExecStartPre=-/usr/bin/fusermount -u %h/phone
# Wait (up to 60s) until the phone actually exposes its storage, i.e. "Allow access to
# phone data" was tapped. jmtpfs lists storage once at startup, so starting it before the
# grant leaves a dead session that a later tap never revives.
ExecStartPre=%h/.local/bin/phone-wait-grant 60
ExecStart=/usr/bin/jmtpfs %h/phone
ExecStop=-/usr/bin/fusermount -u %h/phone
Restart=no
TimeoutStartSec=120
