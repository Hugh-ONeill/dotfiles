[Unit]
Description=job-scan intraday watch (LinkedIn + freehire, new postings only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Developer/job-scan
# Up to watch.max_score LLM calls (~30 x ~37 s while the red-recomp chain shares
# the GPU), so hold the inhibitor: hypridle's 30-min idle suspend would otherwise
# land mid-scoring.
ExecStart=systemd-inhibit --what=sleep --mode=block --why="job-scan watch" %h/Developer/job-scan/.venv/bin/python -m job_scan watch
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/%U
TimeoutStartSec=45min
StandardOutput=journal
StandardError=journal
