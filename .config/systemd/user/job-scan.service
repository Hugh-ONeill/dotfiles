[Unit]
Description=Daily job posting scan against resume
After=network-online.target
Wants=network-online.target
# When the morning report is written (success or not), open the day's LeetCode
# SRS session in a kitty window (unit lives in ~/Developer/leetcode-srs/systemd).
OnSuccess=leetcode-srs-daily.service
OnFailure=leetcode-srs-daily.service

[Service]
Type=oneshot
WorkingDirectory=%h/Developer/job-scan
# Hold a sleep inhibitor for the whole run: hypridle suspends after 30 min idle, which
# would otherwise land mid-run and time out every in-flight request.
ExecStart=systemd-inhibit --what=sleep --mode=block --why="job-scan daily run" %h/Developer/job-scan/run.sh
# Make notify-send able to reach the user session
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/%U
StandardOutput=journal
StandardError=journal
